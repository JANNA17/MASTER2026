        <rdf:Description xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:about="rdf:#06300c6e-3079-406f-bed8-a105630e7790">
            <rdf:value xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xml:lang="en" xmlns:xml="http://www.w3.org/XML/1998/namespace">Checked model in COR.  Added a couple of initial values, corrected the unit definitions and also several units in several equations.</rdf:value>
            <modified xmlns="http://purl.org/dc/terms/">
                <rdf:Description xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" rdf:about="rdf:#5712261e-d6f8-4028-833d-dc14399f529c"/>
            </modified>
